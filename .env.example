
# ================================
# Variables d'environnement requises
# Copie ce fichier en .env et remplis les valeurs
# ================================

# Discord
DISCORD_TOKEN=ton_token_discord_ici
CLIENT_ID=id_application_discord
CLIENT_SECRET=secret_oauth_discord

# Base de données PostgreSQL (ex: Neon, Supabase, Railway PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Sécurité
SESSION_SECRET=une_longue_chaine_aleatoire_ici

# Mots de passe dashboard
DASHBOARD_PASSWORD=mot_de_passe_admin
OWNER_PASSWORD=mot_de_passe_owner

# Environnement
NODE_ENV=production

# Port (Railway l'assigne automatiquement)
PORT=5000
